# Spotify app client ID — from https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=

# OAuth redirect URI — must exactly match a Redirect URI registered on your
# Spotify app. Defaults to the Vite dev server in vite.config.ts if unset.
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:9799/callback
